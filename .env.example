# Copy to .env and uncomment what you want to change; `docker compose up -d --wait` picks it up.
# The values shown are the defaults baked into compose.yaml and tools/serve.sh.

# Tokens per sequence. The GGUF's native context is 262144. 32768 is the model card's laptop example.
#CONTEXT=262144
# Server slots. The context above is the size llama-server allocates; raise this only when you want
# concurrent requests, and watch unified memory.
#PARALLEL=1
# Layers on the GPU. `all` fits easily next to the 7.89 GB weights.
#NGL=all

# Speculative decoding: a drafter proposes tokens, Saluki verifies them in one pass. Output quality is
# Saluki's own; greedy text can differ from SPEC=none after a near-tied token (batch float order).
#   dflash  z-lab's DFlash2 drafter for Qwen3.8-27B (1.14 GB) + ngram-mod. Fastest on code, tools, English.
#   mtp     Kujira's Saluki file with Qwen3.8's MTP head grafted on (8.35 GB, main weights byte-identical)
#           + ngram-mod. Slower overall, but holds up better on Dutch and other non-English text.
#   none    plain decode, about 24 tok/s.
#SPEC=dflash
# Tokens drafted per step. Empty uses the measured best: 4 for dflash, 3 for mtp.
#SPEC_DRAFT_MAX=

# General-use sampling from the model card. Tool calls should send temperature 0 per request.
#TEMP=0.6
#TOP_P=0.95
#TOP_K=20
# Not in the card (it uses 0). 0.05 drops tokens under 5% of the top token's probability. In Dutch weather
# text the 2-bit weights give "Bedeckt" 0.036x the probability of "Bedekt", so 0.05 removes it.
#MIN_P=0.05

# Server-wide reasoning effort: low, medium, or xhigh. Unset keeps the chat template's default (xhigh)
# and leaves each request free to set chat_template_kwargs.reasoning_effort or enable_thinking.
#REASONING_EFFORT=low

# Vision projector. Empty keeps the server text-only. Either published file works:
#   mmproj-Underdog-Saluki-27B-1.0-Q8_0.gguf   (629 MB)
#   mmproj-Underdog-Saluki-27B-1.0-F16.gguf    (928 MB)
#MMPROJ=mmproj-Underdog-Saluki-27B-1.0-Q8_0.gguf

#SERVED_NAME=Underdog-Saluki-27B
#HOST=0.0.0.0
#PORT=8888
# Set to require a bearer token on the API.
#API_KEY=

#MODEL_ID=ConwayResearch/Underdog-Saluki-27B-1.0
#MODEL_REVISION=1336c0b5d74dfe6ad7f793577092f5effd9f97c6
#MODEL_FILE=Underdog-Saluki-27B-1.0-IQ2-mix.gguf
# llama.cpp b11515 (3d65c90d0), the arm64 CUDA 13 image. b11459 predates the DFlash head fix (#30111).
#LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda13@sha256:6869e4456217802e5372774be236a9aa93666cfb7f033b7d39cd58b178af6489

#MODEL_DIR=~/.cache/underdog-saluki
#RUNTIME_CACHE=~/.cache/underdog-saluki-dgx-spark
# Only needed if the model ever becomes gated.
#HF_TOKEN=
